{
  "name": "vansail-carpool-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/generated.ts && node scripts/compact-contract.mjs && node scripts/generate-response-schemas.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:structure": "node scripts/check-structure.mjs",
    "check": "npm run audit:structure && npm run lint && npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@iconify-json/circle-flags": "^1.2.14",
    "@iconify-json/lucide": "^1.2.150",
    "@iconify-json/ph": "^1.2.2",
    "@noble/hashes": "2.4.0",
    "@nuxt/ui": "4.12.0",
    "@unovis/ts": "1.7.1",
    "@unovis/vue": "1.7.1",
    "gsap": "^3.15.0",
    "motion-v": "^2.10.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    },
    "esbuild": "$esbuild"
  }
}
